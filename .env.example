NEXT_PUBLIC_SITE_URL=https://your-domain.com
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/promptspace?retryWrites=true&w=majority
ADMIN_EMAIL=admin@example.com
# Generate a bcrypt hash for your password; never commit real credentials.
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash
ADMIN_JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
USER_JWT_SECRET=replace_with_a_different_random_secret_at_least_32_chars
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
